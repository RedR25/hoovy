# App
APP_NAME=hoovy
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (async URL)
DATABASE_URL=sqlite+aiosqlite:///./hoovy.db
# DATABASE_URL=postgresql+asyncpg://hoovy:hoovy@localhost:5432/hoovy

# Security
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Static SPA (leave UNSET in dev — Vite serves the SPA with HMR on :5173).
# In Docker this is set to /app/frontend_dist by the Dockerfile.
# STATIC_DIR=/app/frontend_dist

# Ollama — Gemma 4 E2B handles audio + reasoning in a single round-trip.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_S=60.0

# Kokoro TTS (Python library, in-process).
KOKORO_VOICE=af_bella
KOKORO_SPEED=0.9
KOKORO_LANG_CODE=a

# Demo language: 'en' for the hackathon; 'vi' swaps voice + scenario fields.
LANGUAGE=en

# Mock mode returns canned AI responses — demo safety net.
MOCK_AI=false
