# App
APP_NAME=hoovy
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (async URL)
DATABASE_URL=sqlite+aiosqlite:///./hoovy.db
# DATABASE_URL=postgresql+asyncpg://hoovy:hoovy@localhost:5432/hoovy

# Security
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Static SPA (leave UNSET in dev — Vite serves the SPA with HMR on :5173).
# In Docker this is set to /app/frontend_dist by the Dockerfile.
# STATIC_DIR=/app/frontend_dist
